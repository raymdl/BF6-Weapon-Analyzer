*.pyc

# Local convenience launchers and helper scripts.
serve.bat
Open - *.url

# Local Codex/Claude scratch, migration, and extraction helpers.
.claude/
memory/
CLAUDE.md
TODO.md

# Local data utilities.
data/check_all.sh

# Local screenshot corpus for the attachment audit (~1.7 GB of captures).
Weapon Attachments/

# The attachment screenshot audit is a one-off exercise, not part of the site.
# Its tooling reads the local screenshot corpus and the ignored audit outputs
# below, so none of it builds or tests on a clean clone; only values promoted
# into data/ come back to the repo.
#
# The audit's instructions and correction history ARE tracked, because they are
# the only record of how the corpus was built and corrected and are too valuable
# to keep on one machine. The per-class handoff prompts stay local.
*_ATTACHMENT_SCREENSHOT_AUDIT_PROMPT.md
schemas/outputs/
scripts/*attachment-screenshot*
# Reads only the tracked schema and review JSON, so it runs on a clean clone and
# guards the tracked data against drifting from its declared contract. The
# taxonomy test stays local: it imports the taxonomy module, which the review
# builder also imports, and none of that chain runs without the corpus.
!scripts/attachment-screenshot-schema.test.mjs
scripts/build-attachment-capture-order.mjs
scripts/extract-corpus-recoil-glyphs.py
# Contact-sheet and review-crop generators for the audit's visual passes.
scripts/make-*-sheets.py
scripts/make-*-review.py
scripts/make-*-crops.py
scripts/*-sidearm-*.mjs
scripts/*-sidearm-*.py
scripts/extract-attachment-panel-ocr.ps1
scripts/extract-attachment-stat-comparisons.ps1
scripts/extract-missing-attachment-fields.ps1
scripts/organize-attachment-screenshot-folders.ps1
scripts/reconcile-attachment-ocr-paths.mjs
scripts/reconcile-lmg-ocr-paths.mjs
scripts/*-dmr-*.mjs
scripts/*-dmr-*.py
scripts/*-lmg-*.mjs
scripts/*-lmg-*.py
scripts/verify-workbook-alignment.py
scripts/compare-audit-idempotence.mjs
scripts/reconcile-and-prune-attachment-overrides.mjs

# Local analysis workbooks at the repo root. Values that matter are promoted
# into data/; the exports under outputs/ that back committed data are handled
# by the outputs rules below.
/*.xlsx

# Generated analysis/export artifacts: video frames, OCR dumps and audit
# captures run to hundreds of megabytes, so the whole directory is local-only.
# The exceptions are the exports that back committed data and must stay with it.
outputs/*
!outputs/damage_falloff.xlsx
!outputs/sym-damage-refresh-*/
sl9_recheck/

# The attachment audit's curated data is tracked, along with the scripts that
# produced it. These are hand-corrected over many passes and cannot be
# regenerated: rebuilding from OCR drops records and reverts manual fixes, so
# the JSON is the artifact, not a build product. Everything else in the audit
# tree stays local -- the raw OCR dumps regenerate from the screenshots, the
# contact sheets and workbooks regenerate from the JSON, and the dated backups
# are superseded by git history once this is tracked.
!outputs/attachment-audit/
outputs/attachment-audit/*
!outputs/attachment-audit/*.mjs
!outputs/attachment-audit/*.py
!outputs/attachment-audit/attachment-screenshot-review.json
!outputs/attachment-audit/capture-order.json
!outputs/attachment-audit/manual-review-overrides.json
!outputs/attachment-audit/coverage-report.json
!outputs/attachment-audit/rename-manifest.json
!outputs/attachment-audit/rename-provenance.json
!outputs/attachment-audit/stat-comparisons.json
!outputs/attachment-audit/visual-stat-map.json
!outputs/attachment-audit/recoil-visual-map.json
!outputs/attachment-audit/field-ocr.json
!outputs/attachment-audit/highlight-cards.json
!outputs/attachment-audit/cost-ocr.json
!outputs/attachment-audit/subsonic-velocity-treatments-20260731.json
!outputs/attachment-audit/sweep-reviewed-exceptions-20260731.json
!outputs/attachment-audit/bulk-suspect-recapture-summary-20260731.json
!outputs/attachment-audit/deduped-source-record-exclusions-20260731.json
!outputs/attachment-audit/sl9-detailed-recapture-20260731.json

